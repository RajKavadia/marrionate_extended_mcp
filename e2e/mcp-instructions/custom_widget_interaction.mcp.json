{
  "format": "flutter-e2e-mcp-instructions",
  "formatVersion": 1,
  "server": "flutter-e2e-mcp",
  "scenario": "custom_widget_interaction",
  "description": "Tap a custom design-system tile and assert the count increments. Proves the toolkits can drive non-Material widgets.",
  "transportPreference": "marionetteFirst",
  "attachTargetPlaceholder": "{{VM_SERVICE_URI}}",
  "attach": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "connect_app",
      "arguments": {
        "target": "{{VM_SERVICE_URI}}",
        "kind": "vmService"
      }
    }
  },
  "instructions": [
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "home_settings"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "settings_custom_widgets"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_visible",
        "arguments": {
          "key": "ds_tile_tappable"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_visible",
        "arguments": {
          "key": "ds_tile_static"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_text_contains",
        "arguments": {
          "key": "ds_tile_tap_count",
          "text": "taps: 0"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "ds_tile_tappable"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_text_contains",
        "arguments": {
          "key": "ds_tile_tap_count",
          "text": "taps: 1"
        }
      }
    }
  ]
}