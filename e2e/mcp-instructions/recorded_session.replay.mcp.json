{
  "format": "flutter-e2e-mcp-instructions",
  "formatVersion": 1,
  "server": "flutter-e2e-mcp",
  "scenario": "recorded_session_replay",
  "description": "Same recorded actions, with the route taps the recorder missed.",
  "transportPreference": "marionetteFirst",
  "attachTargetPlaceholder": "{{VM_SERVICE_URI}}",
  "attach": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "connect_app",
      "arguments": {
        "target": "{{VM_SERVICE_URI}}",
        "kind": "vmService"
      }
    }
  },
  "instructions": [
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": { "key": "home_profile" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": { "key": "name_field" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "tools/call",
      "params": {
        "name": "mcp_enter_text",
        "arguments": { "key": "name_field", "text": "Raj" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/call",
      "params": {
        "name": "mcp_enter_text",
        "arguments": { "key": "email_field", "text": "rajkavadia78@gmail.com" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
        "name": "mcp_press_back_button",
        "arguments": {}
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": { "key": "home_settings" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": { "key": "settings_mouse_tap" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "tools/call",
      "params": {
        "name": "mcp_secondary_tap",
        "arguments": { "key": "mouse_tap_target" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 10,
      "method": "tools/call",
      "params": {
        "name": "mcp_secondary_tap",
        "arguments": { "key": "mouse_tap_target" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 11,
      "method": "tools/call",
      "params": {
        "name": "mcp_secondary_tap",
        "arguments": { "key": "mouse_tap_target" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 12,
      "method": "tools/call",
      "params": {
        "name": "mcp_press_back_button",
        "arguments": {}
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 13,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": { "key": "settings_scoped_matching" }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 14,
      "method": "tools/call",
      "params": {
        "name": "mcp_swipe",
        "arguments": {
          "key": "scoped_matching_screen",
          "direction": "down",
          "distance": 24
        }
      }
    }
  ]
}
