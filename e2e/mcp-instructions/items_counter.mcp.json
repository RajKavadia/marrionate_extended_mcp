{
  "format": "flutter-e2e-mcp-instructions",
  "formatVersion": 1,
  "server": "flutter-e2e-mcp",
  "scenario": "items_counter",
  "description": "Increment the counter three times and assert the resulting text, then assert the row count.",
  "transportPreference": "marionetteFirst",
  "attachTargetPlaceholder": "{{VM_SERVICE_URI}}",
  "attach": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "connect_app",
      "arguments": {
        "target": "{{VM_SERVICE_URI}}",
        "kind": "vmService"
      }
    }
  },
  "instructions": [
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "home_settings"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "settings_items"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_visible",
        "arguments": {
          "key": "items_counter"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_text_contains",
        "arguments": {
          "key": "items_counter",
          "text": "Count: 0"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "items_increment"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "items_increment"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "tools/call",
      "params": {
        "name": "mcp_tap",
        "arguments": {
          "key": "items_increment"
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "tools/call",
      "params": {
        "name": "mcp_assert_text_contains",
        "arguments": {
          "key": "items_counter",
          "text": "Count: 3"
        }
      }
    }
  ]
}